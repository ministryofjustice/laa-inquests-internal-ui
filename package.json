{
  "name": "laa-express-typescript-template",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "main": "public/app.js",
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "start": "node public/app.js",
    "clean": "rm -rf public",
    "build": "yarn clean && yarn build:ts && node public/esbuild.js",
    "lint": "yarn eslint .  --concurrency=auto && yarn prettier . --check",
    "lint:fix": "yarn eslint . --fix --concurrency=auto; yarn prettier . --write",
    "dev": "yarn build:ts && concurrently \"tsc --watch\" \"node public/esbuild.js --watch\" \"nodemon\"",
    "docker": "docker compose -f docker-compose.test.yaml up --build",
    "seed-app": "sh ./scripts/seed-app.sh",
    "deploy": "./scripts/deploy.sh",
    "prepare": "husky",
    "tsc": "tsc --noEmit",
    "build:ts": "tsc",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "yarn build && NODE_ENV=test mocha",
    "test:e2e": "yarn clean && yarn build:ts && node public/esbuild.js && yarn playwright test --config=tests/playwright/playwright.config.ts --reporter=list"
  },
  "engines": {
    "node": "26.7.0"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@ministryofjustice/frontend": "^11.0.0",
    "@redis/client": "^6.2.1",
    "axios": "^1.20.0",
    "body-parser": "^2.3.0",
    "compression": "^1.8.1",
    "connect-redis": "^10.0.0",
    "cookie-parser": "~1.4.6",
    "csrf-sync": "^4.2.1",
    "debug": "~4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "figlet": "^1.11.4",
    "fs-extra": "^11.4.0",
    "govuk-frontend": "^6.5.0",
    "helmet": "^8.3.0",
    "http-errors": "~2.0.1",
    "i18next": "^26.4.0",
    "moment": "^2.30.1",
    "morgan": "~1.12.0",
    "nunjucks": "^3.2.4",
    "otpauth": "^9.5.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chai": "^5.2.3",
    "@types/compression": "^1.7.5",
    "@types/connect-livereload": "^0.6.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/figlet": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/livereload": "^0.9.5",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.4.0",
    "@types/nunjucks": "^3.2.6",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "axe-core": "^4.13.0",
    "chai": "^6.2.2",
    "chokidar": "5.0.0",
    "concurrently": "^10.0.5",
    "connect-livereload": "^0.6.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.9.1",
    "eslint-config-love": "^155.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "livereload": "^0.10.2",
    "middleware-axios": "^3.0.0",
    "mocha": "^11.8.0",
    "msw": "^2.15.0",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "sass-embedded": "^1.103.1",
    "sinon": "^22.1.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-sinon": "^2.0.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.10.3"
}
