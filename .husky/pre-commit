echo "Pre Commit Checks"
set -e

echo "Running MoJ secret scanning baseline"
if command -v prek >/dev/null 2>&1
then
  prek run baseline --hook-stage pre-commit
else
  echo "Missing prerequisite: install both 'prek' and 'gitleaks' to run devsecops hooks."
  echo "On macOS: brew install prek gitleaks"
  exit 1
fi

echo "Running Linting Fix"

yarn eslint . --fix --concurrency=auto

echo "Running Prettier Fix"
set +e
yarn prettier . --check
code=$?
set -e

echo "Code is: $code"

if [[ $code -ne 0 ]]
then
  echo "Running Prettier --write"
  yarn prettier . --write
  echo "Exiting $code"
  exit $code
fi

git status