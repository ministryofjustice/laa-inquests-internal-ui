{% extends "layouts/page-with-back-link.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% block pageContent %}
    <div class="certificate-view">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-l">{{t('pages.applicationCertificate.title')}}</h1>
            </div>
            <div class="govuk-grid-column-two-thirds">
                <p class="govuk-body">
                    <strong>Client:</strong> placeholder
                    <br/>
                    <strong>LAA Reference number:</strong> placeholder
                    <br/>
                    <strong>Date created:</strong> placeholder
                </p>
            </div>
            <section class="overview">
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-two-thirds">
                        <h2 class="govuk-heading-m">Overview</h2>
                    </div>
                </div>
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-two-thirds">
                        <div class="certificate-details-table">
                            {{ govukSummaryList({
                                card: {
                                    title: {
                                        text: "Certificate details"
                                    },
                                    classes: "govuk-!-margin-bottom-0"
                                },
                                rows: [
                                {
                                    key: {
                                        text: "Client name"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Client address"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Firm name"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Office address"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Opponent details"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Guardian name"
                                    },
                                    value: {
                                        text: "Not applicable"
                                    }
                                },
                                {
                                    key: {
                                        text: "Guardian address"
                                    },
                                    value: {
                                        text: "Not applicable"
                                    }
                                }]
                            }) }}
                        </div>
                    </div>
                </div>
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-two-thirds">
                        {{ govukInsetText({
                            text: "This is to certify that the status of the certificate is as specified in the Certificate summary. Its scope is specified in the proceedings listed and is subject to the limitations and conditions."
                        }) }}
                    </div>
                </div>
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-two-thirds">
                        <div class="certificate-summary-table">
                            {{ govukSummaryList({
                            card: {
                                title: {
                                    text: "Certificate summary"
                                },
                                classes: "govuk-!-margin-bottom-0"
                            },
                            rows: [
                            {
                                key: {
                                    text: "Certificate type"
                                },
                                value: {
                                    text: "placeholder"
                                }
                            },
                            {
                                key: {
                                    text: "Status"
                                },
                                value: {
                                    text: "placeholder"
                                }
                            },
                            {
                                key: {
                                    text: "Effective date"
                                },
                                value: {
                                    text: "placeholder"
                                }
                            },
                            {
                                key: {
                                    text: "End date"
                                },
                                value: {
                                    text: "Not applicable"
                                }
                            },
                            {
                                key: {
                                    text: "Reinstatement date"
                                },
                                value: {
                                    text: "Not applicable"
                                }
                            },
                            {
                                key: {
                                    text: "Cost limitation"
                                },
                                value: {
                                    text: "placeholder"
                                }
                            },
                            {
                                key: {
                                    text: "Cost limitation effective date"
                                },
                                value: {
                                    text: "Not applicable"
                                }
                            },
                            {
                                key: {
                                    text: "Certificate limitation"
                                },
                                value: {
                                    text: "Not applicable"
                                }
                            }]
                        }) }}
                        </div>
                    </div>
                </div>
            </section>
            <section class="scope">
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-two-thirds">
                        {{ govukInsetText({
                            text: "This certificate imposes both scope and financially implications on the work to be done under it. Providers should check the limitations imposed carefully and apply for an amendment where appropriate."
                        }) }}
                    </div>
                </div>
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-two-thirds">
                        {{ govukWarningText({
                            text: "Payment will not be made for work undertaken outside the scope specified or in excess of the cost limit.",
                            iconFallbackText: "Warning"
                        }) }}
                    </div>
                </div>
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-two-thirds">
                        <h2 class="govuk-heading-m">Scope</h2>
                    </div>
                </div>
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-two-thirds">
                        <div class="certificate-proceeding-1">
                            {{ govukSummaryList({
                            card: {
                                title: {
                                    text: "1. placeholder"
                                }
                            },
                            rows: [
                                {
                                    key: {
                                        text: "Description"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Category of law"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Current proceeding status"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Date work can be commenced on the above proceeding"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Proceeding end date"
                                    },
                                    value: {
                                        text: "Not applicable"
                                    }
                                },
                                {
                                    key: {
                                        text: "Client involvement type"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Level of service"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Date current level of service effective"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Previous level of service"
                                    },
                                    value: {
                                        text: "Not applicable"
                                    }
                                },
                                {
                                    key: {
                                        text: "Date previous level of service effective"
                                    },
                                    value: {
                                        text: "Not applicable"
                                    }
                                },
                                {
                                    key: {
                                        text: "Limitation"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "Effective date"
                                    },
                                    value: {
                                        text: "placeholder"
                                    }
                                },
                                {
                                    key: {
                                        text: "End date"
                                    },
                                    value: {
                                        text: "Not applicable"
                                    }
                                }
                            ]
                            }) }}
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}