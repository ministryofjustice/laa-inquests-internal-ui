{% extends "layouts/page-with-back-link.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{%- from "govuk/components/tag/macro.njk" import govukTag -%}
{% from "macros/meritsDecisionTag.njk" import meritsDecisionTag %}

{% set pageTitle = t('pages.decision.confirmation.header') %}

{% block pageContent %}
<form data-testid="check-your-answers" method="post" action="/applications/{{ applicationId }}/decision/confirmation">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
  <h1 class="govuk-heading-l">{{ t('pages.decision.confirmation.header') }}</h1>
  {{ govukSummaryList({
    card: {
      title: {
        text: t('pages.decision.confirmation.cardTitle')
      }
    },
    rows: [
      {
        key: {
          text: t('pages.decision.confirmation.certificateTypeTitle')
        },
        value: {
          text: proceeding.certificateType
        }
      },
      {
        key: {
            text: t('pages.decision.confirmation.certificateStartDateTitle')
        },
        value: {
            text: certificateStartDate
        },
        actions: {
            items: [
            {
              href: "/applications/" + applicationId + "/decision/certificate-start-date?from=check-your-answers",
                text: t('common.change'),
                visuallyHiddenText: t('pages.decision.confirmation.certificateStartDateTitle')
            }
            ]
        }
      } if overallDecision === "GRANTED",

      {
        key: {
          text: t('pages.decision.confirmation.meritsAssessmentTitle')
        },
        value: {
            html: meritsDecisionTag(overallDecision)
        },
        actions: {
          items: [
            {
              href: "/applications/" + applicationId + "/decision?from=check-your-answers",
              text: t('common.change'),
              visuallyHiddenText: t('pages.decision.confirmation.overallDecisionTitle')
            }
          ]
        }
      },
        {
        key: {
            text: t('pages.decision.confirmation.refusalReasonTitle')
        },
        value: {
            text: refusalReasonLabel
        },
        actions: {
            items: [
            {
              href: "/applications/" + applicationId + "/decision/justification?from=check-your-answers",
                text: t('common.change'),
                visuallyHiddenText: t('pages.decision.confirmation.refusalReasonTitle')
            }
            ]
        }
        } if overallDecision === "REFUSED",
        {
        key: {
            text: t('pages.decision.confirmation.justificationTitle')
        },
        value: {
            text: justification
        },
        actions: {
            items: [
            {
              href: "/applications/" + applicationId + "/decision/justification?from=check-your-answers",
                text: t('common.change'),
                visuallyHiddenText: t('pages.decision.confirmation.justificationTitle')
            }
            ]
        }
      } if overallDecision === "REFUSED"
    ]
  }) }}
  {{ govukButton({
    text: t('pages.decision.confirmation.submitButton')
  }) }}
</form>
{% endblock pageContent %}
