{% extends "base.njk" %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = t('pages.decision.success.header') %}

{% block content %}
  {{ govukPanel({
    titleText: t('pages.decision.success.header'),
    html: "<div>" + t('pages.decision.success.referenceLabel') + ":</div><div><strong>" + laaReference + "</strong></div>"
  }) }}

  <h2 class="govuk-heading-s govuk-!-padding-top-6">{{ t('pages.decision.success.whatHappensNext') }}</h2>
  <p class="govuk-body  govuk-!-padding-bottom-6">{{ t('pages.decision.success.whatHappensNextBody') }}</p>

  {{ govukButton({
    text: t('pages.decision.success.applicationOverviewReturnButton'),
    href: "/applications/" + laaReference + "/overview"
  }) }}
{% endblock %}
