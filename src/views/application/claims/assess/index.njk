{% extends "layouts/page-with-back-link.njk" %}
{% from "macros/claimOverview.njk" import claimOverview %}
{% from "macros/finalOrNilBillDetails.njk" import finalOrNilBillDetailsCards %}
{% from "macros/supportingEvidence.njk" import supportingEvidenceSection %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set pageTitle = t('pages.claimAssessment.heading') %}

{% block pageContent %}
{% if errorSummaries %}
  {{ govukErrorSummary({
    titleText: t('common.errorSummaryTitle'),
    errorList: [
      { text: errorSummaries.assessClaim.text, href: '#assess-claim' } if errorSummaries.assessClaim,
      { text: errorSummaries.rejectionReason.text, href: '#rejection-reason' } if errorSummaries.rejectionReason
    ]
  }) }}
{% endif %}

<form data-testid="assess-claim" method="post" action="/applications/{{ laaReference }}/claims/{{ claimReference }}">
  <input type="hidden" name="_csrf" value="{{csrfToken}}" />

  <h1 class="govuk-heading-l">{{ t('pages.claimAssessment.heading') }}</h1>
  <h2 class="govuk-heading-m">{{ laaReference }}</h2>
  <h3 class="govuk-heading-s">{{ t('pages.claimAssessment.claimStatus') }}: <span class="govuk-tag govuk-tag--blue">{{ claimStatus }}</span></h3>

  {{ claimOverview(overview, true) }}

  {{ finalOrNilBillDetailsCards(finalOrNilBillDetails) }}

  {{ supportingEvidenceSection(claimCostBreakdown, supportingEvidence) }}

  {% if hasPermission(permissions.MAKE_CLAIM_DECISION) %}
  {{ govukRadios({
    idPrefix: 'assess-claim',
    name: 'assessClaim',
    value: assessClaim,
    fieldset: {
      legend: {
        text: t('pages.claimAssessment.radio.label'),
        isPageHeading: false,
        classes: 'govuk-fieldset__legend--l'
      }
    },
    errorMessage: errorSummaries.assessClaim,
    items: [
      {
        value: 'Pay in full',
        text: t('pages.claimAssessment.radio.payInFull')
      },
      {
        value: 'Reject',
        text: t('pages.claimAssessment.radio.reject'),
        conditional: {
          html: govukCharacterCount({
            name: "rejection-reason",
            id: "rejection-reason",
            maxlength: 500,
            value: rejectionReason,
            label: {
              text: t('pages.claimAssessment.reasonLabel'),
              classes: "govuk-!-font-weight-bold"
            },
            hint: {
              text: t('pages.claimAssessment.reasonHint')
            },
            errorMessage: errorSummaries.rejectionReason
          })
        }
      }
    ]
  }) }}

  {{ govukButton({
    text: t('pages.claimAssessment.continue')
  }) }}
</form>

{% endif %}
{% endblock pageContent %}
