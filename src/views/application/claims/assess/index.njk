{% extends "layouts/page-with-back-link.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block pageContent %}
{% if errorSummaries %}
  {{ govukErrorSummary({
    titleText: t('common.errorSummaryTitle'),
    errorList: [
      { text: errorSummaries.assessClaim.text, href: '#assess-claim' } if errorSummaries.assessClaim,
      { text: errorSummaries.rejectionReason.text, href: '#rejection-reason' } if errorSummaries.rejectionReason
    ]
  }) }}
{% endif %}

{% set supportingEvidenceRows = [] %}
{% for evidence in supportingEvidence %}
  {% set supportingEvidenceRows = supportingEvidenceRows.concat([
    {
      key: {
        text: evidence.fileName
      },
      actions: {
        items: [
          {
            href: evidence.viewHref,
            text: t('pages.claimAssessment.supportingEvidence.view'),
            visuallyHiddenText: t('pages.claimAssessment.supportingEvidence.view') + ' ' + evidence.fileName
          },
          {
            href: evidence.downloadHref,
            text: t('pages.claimAssessment.supportingEvidence.download'),
            visuallyHiddenText: t('pages.claimAssessment.supportingEvidence.download') + ' ' + evidence.fileName
          }
        ]
      }
    }
  ]) %}
{% endfor %}

<form data-testid="assess-claim" method="post" action="/applications/{{ applicationId }}/claims/{{ claimId }}">
  <input type="hidden" name="_csrf" value="{{csrfToken}}" />

  <h1 class="govuk-heading-l">{{ t('pages.claimAssessment.heading') }}</h1>
  <h2 class="govuk-heading-m">{{ laaReference }}</h2>
  <h3 class="govuk-heading-s">{{ t('pages.claimAssessment.claimStatus') }}: <span class="govuk-tag govuk-tag--blue">{{ claimStatus }}</span></h3>

  {{ govukSummaryList({
    card: {
      title: {
        text: t('pages.claimAssessment.overview.title')
      }
    },
    rows: [
      {
        key: {
          text: t('pages.claimAssessment.overview.paymentType')
        },
        value: {
          text: overview.paymentType
        }
      },
      {
        key: {
          text: t('pages.claimAssessment.overview.paymentAmount')
        },
        value: {
          text: overview.paymentAmount
        }
      },
      {
        key: {
          text: t('pages.claimAssessment.overview.substantiveCertificate')
        },
        value: {
          text: overview.substantiveCertificate
        }
      },
      {
        key: {
          text: t('pages.claimAssessment.overview.totalRemaining')
        },
        value: {
          text: overview.totalRemaining
        }
      }
    ]
  }) }}

  {% if not finalOrNilBillDetails %}
  {{ govukSummaryList({
    card: {
      title: {
        text: t('pages.claimAssessment.details.title')
      }
    },
    rows: [
      {
        key: {
          text: t('pages.claimAssessment.details.instructedCounsel')
        },
        value: {
          text: details.instructedCounsel
        }
      },
      {
        key: {
          text: t('pages.claimAssessment.details.lastWorkingDate')
        },
        value: {
          text: details.lastWorkingDate
        }
      },
      {
        key: {
          text: t('pages.claimAssessment.details.outcomeOfInquest')
        },
        value: {
          text: details.outcomeOfInquest
        }
      },
      {
        key: {
          text: t('pages.claimAssessment.details.alternateFunding')
        },
        value: {
          text: details.alternateFundingProgressed
        }
      }
    ]
  }) }}
  {% endif %}

  {% if finalOrNilBillDetails %}
    {% if finalOrNilBillDetails.claimCostTemplateFile or finalOrNilBillDetails.supportingEvidence.length %}
      {% if finalOrNilBillDetails.claimCostTemplateFile %}
        {{ govukSummaryList({
          card: { title: { text: t('pages.claimAssessment.finalOrNilBill.evidence.heading') } },
          rows: [
            {
              key: { text: t('pages.claimAssessment.finalOrNilBill.evidence.claimCostFile') },
              value: { text: finalOrNilBillDetails.claimCostTemplateFile.fileName },
              actions: {
                items: [
                  {
                    href: finalOrNilBillDetails.claimCostTemplateFile.downloadHref,
                    text: t('pages.claimAssessment.supportingEvidence.download'),
                    visuallyHiddenText: t('pages.claimAssessment.supportingEvidence.download') + ' ' + finalOrNilBillDetails.claimCostTemplateFile.fileName
                  }
                ]
              }
            }
          ]
        }) }}
      {% endif %}
      {% if finalOrNilBillDetails.supportingEvidence.length %}
        {{ govukSummaryList({
          card: { title: { text: t('pages.claimAssessment.finalOrNilBill.evidence.supportingFiles') } },
          rows: supportingEvidenceRows
        }) }}
      {% endif %}
    {% endif %}

    {% if finalOrNilBillDetails.counsel %}
      {{ govukSummaryList({ card: { title: { text: t('pages.claimAssessment.finalOrNilBill.counsel.heading') } }, rows: [
        { key: { text: t('pages.claimAssessment.finalOrNilBill.counsel.numberInstructed') }, value: { text: finalOrNilBillDetails.counsel.numberInstructed } },
        { key: { text: t('pages.claimAssessment.finalOrNilBill.counsel.hasBeenPaid') }, value: { text: finalOrNilBillDetails.counsel.hasBeenPaid } },
        { key: { text: t('pages.claimAssessment.finalOrNilBill.counsel.lastWorkingDate') }, value: { text: finalOrNilBillDetails.counsel.lastWorkingDate } }
      ] }) }}
    {% endif %}

    {% if finalOrNilBillDetails.inquestDetails or finalOrNilBillDetails.alternativeFundingDetails or finalOrNilBillDetails.financialRecoveryCosts %}
      <h3 class="govuk-heading-m">{{ t('pages.claimAssessment.finalOrNilBill.otherDetails.heading') }}</h3>
      {% if finalOrNilBillDetails.inquestDetails %}
        {{ govukSummaryList({ card: { title: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.inquestDetails') } }, rows: [
          { key: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.outcome') }, value: { text: finalOrNilBillDetails.inquestDetails.outcome } },
          { key: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.alternativeFundingPostInquest') }, value: { text: finalOrNilBillDetails.inquestDetails.alternativeFundingPostInquest } }
        ] }) }}
      {% endif %}
      {% if finalOrNilBillDetails.alternativeFundingDetails %}
        {{ govukSummaryList({ card: { title: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.alternativeFundingDetails') } }, rows: [
          { key: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.recoveryCostsMade') }, value: { text: finalOrNilBillDetails.alternativeFundingDetails.recoveryCostsMade } },
          { key: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.previousPreCertificateCosts') }, value: { text: finalOrNilBillDetails.alternativeFundingDetails.previousPreCertificateCosts } },
          { key: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.payingParty') }, value: { text: finalOrNilBillDetails.alternativeFundingDetails.payingParty } }
        ] }) }}
      {% endif %}
      {% if finalOrNilBillDetails.financialRecoveryCosts %}
        {{ govukSummaryList({ card: { title: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.financialRecoveryCosts') } }, rows: [
          { key: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.costs') }, value: { text: finalOrNilBillDetails.financialRecoveryCosts.costs } },
          { key: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.damages') }, value: { text: finalOrNilBillDetails.financialRecoveryCosts.damages } },
          { key: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.interest') }, value: { text: finalOrNilBillDetails.financialRecoveryCosts.interest } },
          { key: { text: t('pages.claimAssessment.finalOrNilBill.otherDetails.previousPreCertificateCosts') }, value: { text: finalOrNilBillDetails.financialRecoveryCosts.previousPreCertificateCosts } }
        ] }) }}
      {% endif %}
    {% endif %}
  {% endif %}

  {% if not finalOrNilBillDetails %}
  <h3 class="govuk-heading-m">{{ t('pages.claimAssessment.supportingEvidence.heading') }}</h3>

  {{ govukWarningText({
    text: t('pages.claimAssessment.supportingEvidence.warning'),
    iconFallbackText: t('common.warning')
  }) }}

  {% if supportingEvidenceRows.length %}
    {{ govukSummaryList({
        card: {
          title: {
            text: t('pages.claimAssessment.supportingEvidence.otherEvidence')
          }
        },
        rows: supportingEvidenceRows
      }) }}
  {% endif %}
  {% endif %}

  {{ govukRadios({
    idPrefix: 'assess-claim',
    name: 'assessClaim',
    value: assessClaim,
    fieldset: {
      legend: {
        text: t('pages.claimAssessment.radio.label'),
        isPageHeading: false,
        classes: 'govuk-fieldset__legend--l'
      }
    },
    errorMessage: errorSummaries.assessClaim,
    items: [
      {
        value: 'Pay in full',
        text: t('pages.claimAssessment.radio.payInFull')
      },
      {
        value: 'Reject',
        text: t('pages.claimAssessment.radio.reject'),
        conditional: {
          html: govukCharacterCount({
            name: "rejection-reason",
            id: "rejection-reason",
            maxlength: 500,
            value: rejectionReason,
            label: {
              text: t('pages.claimAssessment.reasonLabel'),
              classes: "govuk-!-font-weight-bold"
            },
            hint: {
              text: t('pages.claimAssessment.reasonHint')
            },
            errorMessage: errorSummaries.rejectionReason
          })
        }
      }
    ]
  }) }}

  {{ govukButton({
    text: t('pages.claimAssessment.continue')
  }) }}
</form>
{% endblock pageContent %}
