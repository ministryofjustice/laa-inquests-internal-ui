{% extends "layouts/page-with-back-link.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "macros/claimOverview.njk" import claimOverview %}
{% from "macros/assessmentDetails.njk" import assessmentDetailsSection %}
{% from "macros/finalOrNilBillDetails.njk" import finalOrNilBillDetailsCards %}
{% from "macros/supportingEvidence.njk" import supportingEvidenceSection %}

{% set pageTitle = claimReference %}

{% block pageContent %}
<div data-testid="assessed-claim">
  <h1 class="govuk-heading-l">{{ claimReference }}</h1>
  <h3 class="govuk-heading-s">{{ t('pages.claimAssessment.claimStatus') }}: {{ govukTag(claimStatusTag) }}</h3>

  {{ assessmentDetailsSection(assessmentDetails) }}

  <h2 class="govuk-heading-m">{{ t('pages.claimAssessment.claimDetailsHeading') }}</h2>

  {{ claimOverview(overview, false) }}

  {{ finalOrNilBillDetailsCards(finalOrNilBillDetails) }}

  {{ supportingEvidenceSection(claimCostBreakdown, supportingEvidence) }}
</div>
{% endblock pageContent %}
