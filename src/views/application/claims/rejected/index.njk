{% extends "base.njk" %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ govukPanel({
    titleText: t('pages.claimAssessment.rejectedSuccess.panel', { claimType: claimType })
  }) }}

  <h2 class="govuk-heading-s govuk-!-padding-top-6">{{ t('pages.claimAssessment.rejectedSuccess.whatHappensNext') }}</h2>
  <p class="govuk-body">{{ t('pages.claimAssessment.rejectedSuccess.whatHappensNextBody') }}</p>

  {{ govukWarningText({
    text: t('pages.claimAssessment.rejectedSuccess.warning'),
    iconFallbackText: "Warning"
  }) }}

  {{ govukButton({
    text: t('pages.claimAssessment.rejectedSuccess.assessNewClaimButton'),
    href: "/applications/" + applicationId + "/overview#claims"
  }) }}
{% endblock %}
