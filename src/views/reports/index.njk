{% extends "layouts/page-with-back-link.njk" %}

{% set pageTitle = t('pages.reports.heading') %}

{% block content %}
    <h1 class="govuk-heading-xl">{{ t('pages.reports.heading') }}</h1>

  {%- from "govuk/components/warning-text/macro.njk" import govukWarningText -%}

  {{ govukWarningText({
    text: t('pages.home.developerBanner.text'),
    iconFallbackText: t('pages.home.developerBanner.title')
  }) }}
    {% if hasPermission(permissions.VIEW_APPLICATIONS_REPORTS) %}
        <p class="govuk-body">
          <a class="govuk-link" href="/reports/applications/backlog">{{ t('pages.reports.downloadApplicationsBacklogLink') }}</a>
        </p>
    {% endif %}

    {% if hasPermission(permissions.VIEW_CLAIMS_REPORTS) %}
        <p class="govuk-body">
          <a class="govuk-link" href="/reports/claims/backlog">{{ t('pages.reports.downloadClaimsBacklogLink') }}</a>
        </p>
    {% endif %}
{% endblock %}