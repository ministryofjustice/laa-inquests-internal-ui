{% extends "base.njk" %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set pageTitle = t('pages.reports.heading') %}
{% set backLink = backUrl %}

{% macro reportLink(href, text, description) %}
  <p class="govuk-body govuk-!-margin-bottom-1">
    <a class="govuk-link" href="{{ href }}">{{ text }}</a>
  </p>
  <p class="govuk-body">{{ description }}</p>
  <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
{% endmacro %}

{% block content %}
    <h1 class="govuk-heading-xl">{{ t('pages.reports.heading') }}</h1>

  {{ govukInsetText({
    text: t('pages.error.rateLimitError.reportLimitMessage', { RATE_WINDOW_PER_REPORT_SECONDS: config.RATE_WINDOW_PER_REPORT_MS / 1000 })
  }) if shouldShowRateLimitText }}

    {% set sizeOptions = { fileSizeEstimate: t('pages.reports.fileSizeEstimate') } %}

    {% if hasPermission(permissions.VIEW_CLAIMS_REPORTS) or hasPermission(permissions.VIEW_APPLICATIONS_REPORTS) %}
      <h2 class="govuk-heading-m">{{ t('pages.reports.sections.operations') }}</h2>
      {% if hasPermission(permissions.VIEW_CLAIMS_REPORTS) %}
        {{ reportLink("/reports/claims/backlog", t('pages.reports.links.claimsBacklog.text', sizeOptions), t('pages.reports.links.claimsBacklog.description')) }}
      {% endif %}
      {% if hasPermission(permissions.VIEW_APPLICATIONS_REPORTS) %}
        {{ reportLink("/reports/applications/backlog", t('pages.reports.links.applicationsBacklog.text', sizeOptions), t('pages.reports.links.applicationsBacklog.description')) }}
      {% endif %}
    {% endif %}

    {% if hasPermission(permissions.VIEW_PAYMENT_EXTRACT_REPORT) %}
      <h2 class="govuk-heading-m">{{ t('pages.reports.sections.finance') }}</h2>
      {{ reportLink("/reports/payments-extract", t('pages.reports.links.paymentsExtract.text'), t('pages.reports.links.paymentsExtract.description')) }}
    {% endif %}

    {% if hasPermission(permissions.VIEW_COST_ESTIMATION_REPORT) or hasPermission(permissions.VIEW_DECISIONS_REPORT) or hasPermission(permissions.VIEW_OGD_COSTS_REPORT) or hasPermission(permissions.VIEW_AUDIT_TRAIL_REPORT) %}
      <h2 class="govuk-heading-m">{{ t('pages.reports.sections.managementInformation') }}</h2>
      {% if hasPermission(permissions.VIEW_COST_ESTIMATION_REPORT) %}
        {{ reportLink("/reports/cost-estimation-and-forecasting", t('pages.reports.links.costEstimation.text', sizeOptions), t('pages.reports.links.costEstimation.description')) }}
      {% endif %}
      {% if hasPermission(permissions.VIEW_DECISIONS_REPORT) %}
        {{ reportLink("/reports/claims-applications-processing", t('pages.reports.links.claimsApplicationsProcessing.text'), t('pages.reports.links.claimsApplicationsProcessing.description')) }}
      {% endif %}
      {% if hasPermission(permissions.VIEW_OGD_COSTS_REPORT) %}
        {{ reportLink("/reports/costs-for-other-departments", t('pages.reports.links.costsForOtherDepartments.text'), t('pages.reports.links.costsForOtherDepartments.description')) }}
      {% endif %}
      {% if hasPermission(permissions.VIEW_AUDIT_TRAIL_REPORT) %}
        {{ reportLink("/reports/user-audit-trail", t('pages.reports.links.userAuditTrail.text'), t('pages.reports.links.userAuditTrail.description')) }}
      {% endif %}
    {% endif %}

    {% if hasPermission(permissions.VIEW_MI_REPORTS) %}
        <p class="govuk-body">
          <a class="govuk-link" href="#PLACEHOLDER-FOR-AUDIT-TRAIL-LINK" aria-disabled="true">{{ t('pages.reports.userAuditTrailLink') }}</a>
        </p>
        <p class="govuk-body">
          <a class="govuk-link" href="#PLACEHOLDER-FOR-CLAIM-AND-APPLICATIONS-PROCESSING-LINK" aria-disabled="true">{{ t('pages.reports.claimAndApplicationsProcessingLink') }}</a>
        </p>
        <p class="govuk-body">
          <a class="govuk-link" href="#PLACEHOLDER-FOR-COSTS-LINK" aria-disabled="true">{{ t('pages.reports.costsLink') }}</a>
        </p>
    {% endif %}
{% endblock %}
