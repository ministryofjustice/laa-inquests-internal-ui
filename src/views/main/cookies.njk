{% extends "base.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = t('pages.cookies.title') %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">{{ t('pages.cookies.title') }}</h1>
    <p class="govuk-body">{{ t('pages.cookies.description') }}</p>
    <p class="govuk-body">{{ t('pages.cookies.purpose') }}</p>

    <h2 class="govuk-heading-m">{{ t('pages.cookies.essential.heading') }}</h2>
    <p class="govuk-body">{{ t('pages.cookies.essential.body') }}</p>
    {{ govukTable({
      caption: t('pages.cookies.essential.tableCaption'),
      captionClasses: "govuk-table__caption--s",
      firstCellIsHeader: false,
      head: [
        { text: t('pages.cookies.table.name') },
        { text: t('pages.cookies.table.purpose') },
        { text: t('pages.cookies.table.expires') }
      ],
      rows: [
        [
          { text: t('pages.cookies.essential.sessionCookie.name') },
          { text: t('pages.cookies.essential.sessionCookie.purpose') },
          { text: t('pages.cookies.essential.sessionCookie.expires') }
        ],
        [
          { text: t('pages.cookies.essential.cookiePolicy.name') },
          { text: t('pages.cookies.essential.cookiePolicy.purpose') },
          { text: t('pages.cookies.essential.cookiePolicy.expires') }
        ]
      ]
    }) }}

    <h2 class="govuk-heading-m">{{ t('pages.cookies.analytics.heading') }}</h2>
    <p class="govuk-body">{{ t('pages.cookies.analytics.purpose') }}</p>
    <p class="govuk-body">{{ t('pages.cookies.analytics.collection') }}</p>
    <p class="govuk-body">{{ t('pages.cookies.analytics.dataSharing') }}</p>
    <p class="govuk-body">{{ t('pages.cookies.analytics.googleStorage.description') }}</p>
    <ul class="govuk-list govuk-list--bullet">
      <li>{{ t('pages.cookies.analytics.googleStorage.storesPages') }}</li>
      <li>{{ t('pages.cookies.analytics.googleStorage.storesTime') }}</li>
      <li>{{ t('pages.cookies.analytics.googleStorage.storesArrival') }}</li>
      <li>{{ t('pages.cookies.analytics.googleStorage.storesClicks') }}</li>
      <li>{{ t('pages.cookies.analytics.googleStorage.storesDevice') }}</li>
    </ul>

    {{ govukRadios({
      classes: "govuk-radios--small",
      name: "changedName",
      fieldset: {
        legend: {
          text: t('pages.cookies.analytics.radio.label'),
          isPageHeading: true,
          classes: "govuk-fieldset__legend--m"
        }
      },
      items: [
        {
          value: "yes",
          text: t('pages.cookies.analytics.radio.yes')
        },
        {
          value: "no",
          text: t('pages.cookies.analytics.radio.no')
        }
      ]
    }) }}

    {{ govukButton({
      text: t('pages.cookies.saveButton')
    }) }}
  </div>
</div>
{% endblock %}